// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- ENUMERASI (Pilihan Tetap) ---

// Kategori untuk Produk
enum KategoriProduk {
  PRODUK_BUATAN
  CAPSTONE_DESIGN
  PATEN
  PUBLIKASI
  HAK_CIPTA
  DESAIN_INDUSTRI
}

// Peran untuk Keanggotaan
enum PeranAnggota {
  PIMPINAN
  KETUA
  ANGGOTA_PERISET
  WAKIL
  PENELITI_UTAMA
  DOSEN_PEMBIMBING
  ANGGOTA
  PENELITI_ALUMNI
}

// Status Magang
enum StatusMagang {
  MENUNGGU
  DITERIMA
  DITOLAK
}

enum StatusTestimoni {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

// --- TABEL / MODEL DATABASE ---

model Berita {
  id        Int      @id @default(autoincrement())
  judul     String
  konten    String   @db.Text // Menggunakan Text agar bisa menampung artikel panjang
  gambar    String?  // Path/URL foto (opsional, menggunakan tanda '?')
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Produk {
  id          Int            @id @default(autoincrement())
  nama        String
  deskripsi   String?        @db.Text
  kategori    KategoriProduk
  gambar      String?        // Path foto produk di folder public
  sourceUrl   String?        @db.VarChar(512)
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Keanggotaan {
  id          Int          @id @default(autoincrement())
  nama        String
  peran       PeranAnggota // Kategori: Pimpinan, Ketua, atau Anggota
  jabatan     String?      // Opsional: Jika ingin menuliskan nama jabatan lebih spesifik (misal: "Kepala Laboratorium")
  
  // Data Profil Ekstra (Menggunakan Text agar admin bisa mengisinya panjang/berupa paragraf)
  biografi    String?      @db.Text
  gelar       String?      @db.Text
  pengalaman  String?      @db.Text
  lokasi      String?      @db.Text
  jumlahPublikasi String?
  publikasi   Json?
  riset       Json?
  sintaUrl    String?
  sintaStatistik Json?
  hakCipta    Json?
  pengabdian  Json?
  email       String?
  linkedin    String?
  konsultasiUrl String?
  paten       String?      @db.Text
  
  foto        String?      // Path foto anggota di folder public
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Tabel tambahan untuk keperluan Login Admin / CRM
model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // Nanti password ini akan kita Hash (misal pakai bcrypt) demi keamanan
  nama      String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimoni {
  id        Int      @id @default(autoincrement())
  nama      String
  jabatan   String
  teks      String   @db.Text
  foto      String?
  instansi  String?
  status    StatusTestimoni @default(MENUNGGU)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PendaftarMagang {
  id          Int          @id @default(autoincrement())
  nama        String
  email       String
  asalSekolah String
  nisn        String?
  jurusan     String?
  durasi      String?
  motivasi    String?      @db.Text
  status      StatusMagang @default(MENUNGGU)
  suratRekomendasi String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Layanan {
  id        Int      @id @default(autoincrement())
  judul     String
  deskripsi String   @db.Text
  ikon      String?
  gambar    String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KontenWebsite {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model Konsultasi {
  id         Int      @id @default(autoincrement())
  nama       String
  perusahaan String
  email      String?
  layanan    String
  detail     String   @db.Text
  diproses   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
